DB_HOST=localhost
DB_USER=root
DB_PASSWORD=qwertyui
DB_NAME=exam_seating
PORT=3306

# --- CSV Student Import feature ---
# Secret used to sign/verify JWTs on the /api/students/* routes.
# This project does not yet have a login flow that issues tokens;
# see middleware/auth.js for how to test in the meantime.
JWT_SECRET=change-this-in-production

# Set to "true" to bypass JWT verification during local development
# before a real login flow exists. NEVER set this in production.
SKIP_AUTH=true
